<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppAMASBE.Pages.BemEstarPage"
             Title="Bem-estar"
             BackgroundColor="#F7F6FB">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Título -->
            <Label Text="Bem-estar 💙"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#2E2A4D" />

            <Label Text="Cuide de você hoje"
                   FontSize="14"
                   TextColor="#6B6785" />

            <!-- Card principal -->
            <Frame CornerRadius="20"
                   Padding="20"
                   BackgroundColor="#EDE9FF"
                   HasShadow="False">

                <Label Text="✨ Pequenos cuidados fazem grandes diferenças!"
                       FontSize="16"
                       TextColor="#403A5F"/>
            </Frame>

            <!-- Dicas -->
            <Label Text="Dicas do dia"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#2E2A4D" />

            <!-- Água -->
            <Frame CornerRadius="18" Padding="18" BackgroundColor="White" HasShadow="False">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAguaClicked"/>
                </Frame.GestureRecognizers>

                <HorizontalStackLayout Spacing="15">
                    <Label Text="💧" FontSize="28"/>
                    <VerticalStackLayout>
                        <Label Text="Hidratação" FontAttributes="Bold" FontSize="14"/>
                        <Label Text="Já bebeu água hoje?" FontSize="12" TextColor="#6B6785"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Frame>

            <!-- Sono -->
            <Frame CornerRadius="18" Padding="18" BackgroundColor="White" HasShadow="False">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSonoClicked"/>
                </Frame.GestureRecognizers>

                <HorizontalStackLayout Spacing="15">
                    <Label Text="😴" FontSize="28"/>
                    <VerticalStackLayout>
                        <Label Text="Sono" FontAttributes="Bold" FontSize="14"/>
                        <Label Text="Dormiu bem essa noite?" FontSize="12" TextColor="#6B6785"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Frame>

            <!-- Exercício -->
            <Frame CornerRadius="18" Padding="18" BackgroundColor="White" HasShadow="False">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnExercicioClicked"/>
                </Frame.GestureRecognizers>

                <HorizontalStackLayout Spacing="15">
                    <Label Text="🚶" FontSize="28"/>
                    <VerticalStackLayout>
                        <Label Text="Movimento" FontAttributes="Bold" FontSize="14"/>
                        <Label Text="Se movimentou hoje?" FontSize="12" TextColor="#6B6785"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Frame>

            <!-- Tempo pra você -->
            <Frame CornerRadius="18" Padding="18" BackgroundColor="White" HasShadow="False">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTempoClicked"/>
                </Frame.GestureRecognizers>

                <HorizontalStackLayout Spacing="15">
                    <Label Text="🧘" FontSize="28"/>
                    <VerticalStackLayout>
                        <Label Text="Autocuidado" FontAttributes="Bold" FontSize="14"/>
                        <Label Text="Tirou um tempo pra você?" FontSize="12" TextColor="#6B6785"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Frame>

            <!-- Campo + botão -->
            <Frame CornerRadius="18"
                   Padding="15"
                   BackgroundColor="White"
                   HasShadow="False">

                <VerticalStackLayout Spacing="10">

                    <Entry x:Name="entradaTexto"
                           Placeholder="Como você está se sentindo hoje?"
                           TextColor="#2E2A4D"/>

                    <Button Text="Salvar"
                            BackgroundColor="#6C63FF"
                            TextColor="White"
                            CornerRadius="12"
                            Clicked="OnSalvarClicked"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>