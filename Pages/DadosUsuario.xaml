<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppAMASBE.Pages.DadosUsuario"
             Title="Dados do Usuário">

    <Grid>

        <!-- 🔵 VISUALIZAÇÃO -->
        <VerticalStackLayout x:Name="EmptyState"
                             Padding="30"
                             Spacing="10">

            <Label Text="Dados de Usuário"
                   FontSize="24"
                   HorizontalOptions="Start" />
            
      

            <Label Text="{Binding Usuario.Nome, StringFormat='Nome: {0}'}"
                   FontAttributes="Bold" />

            <Label Text="{Binding Usuario.Email, StringFormat='Email: {0}'}"
                   FontAttributes="Bold" />

            <Label Text="{Binding Usuario.Cpf, StringFormat='CPF: {0}'}"
                   FontAttributes="Bold" />

            <Label Text="{Binding Usuario.DataNascimento, StringFormat='Data: {0:dd/MM/yyyy}'}"
                   FontAttributes="Bold" />
            <Label Text="{Binding Usuario.Sexo, StringFormat='Sexo: {0}'}" />
            
            <Label Text="{Binding Usuario.RuaUsuario, StringFormat='Rua: {0}'}" />
            <Label Text="{Binding Usuario.NumeroUsuario, StringFormat='Número: {0}'}" />
            <Label Text="{Binding Usuario.BairroUsuario, StringFormat='Bairro: {0}'}" />
            <Label Text="{Binding Usuario.ComplementoUsuario, StringFormat='Complemento: {0}'}" />
            <Label Text="{Binding Usuario.CidadeUsuario, StringFormat='Cidade: {0}'}" />
            <Label Text="{Binding Usuario.EstadoUsuario, StringFormat='Estado: {0}'}" />
            <Label Text="{Binding Usuario.CepUsuario, StringFormat='CEP: {0}'}" />
            <Label Text="{Binding Usuario.TelefoneUsuario, StringFormat='Telefone: {0}'}" />
            <Label Text="{Binding Usuario.ContatoEmergencia, StringFormat='Telefone de Emergência: {0}'}" />
            <Label Text="{Binding Usuario.Peso, StringFormat='Peso: {0} Kg'}" />
            <Label Text="{Binding Usuario.Altura, StringFormat='Altura: {0} cm'}" />
            <Label Text="{Binding Usuario.TipoSanguineo, StringFormat='Tipo Sanguíneo: {0}'}" />
            
            <Button Text="+ Atualizar"
                    Clicked="Button_Atualizar"
                    BackgroundColor="#6A0DAD"
                    TextColor="White"/>

        </VerticalStackLayout>

        <!-- 🟣 EDIÇÃO -->
        <Frame x:Name="CadastroCard"
               IsVisible="False"
               Padding="20"
               CornerRadius="15"
               BackgroundColor="#404040"
               Margin="20">

            <VerticalStackLayout Spacing="10">

                <Label Text="Editar Dados" FontAttributes="Bold"/>

                <Grid ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
      Padding="10"
      RowSpacing="15"
      ColumnSpacing="30">

                    <!-- Data de nascimento -->
                    <VerticalStackLayout Grid.Column="0" Grid.Row="0" Spacing="5">
                        <Label Text="Data de Nascimento:" />
                        <DatePicker
            x:Name="dtp_nascimento"
            Format="dd/MM/yyyy"
            MaximumDate="{x:Static sys:DateTime.Now}"
            MinimumDate="01/01/1900"/>
                    </VerticalStackLayout>

                    <!-- Estado -->
                    <VerticalStackLayout Grid.Column="1" Grid.Row="0" Spacing="5">
                        <Label Text="Estado:" />
                        <Picker
            
            ItemsSource="{Binding Estados}"
            SelectedItem="{Binding EstadoSelecionado}" />
                    </VerticalStackLayout>

                    <!-- Sexo -->
                    <VerticalStackLayout Grid.Column="0" Grid.Row="1" Spacing="5">
                        <Label Text="Sexo:" />
                        <Picker
            
            ItemsSource="{Binding Sexos}"
            SelectedItem="{Binding SexoSelecionado}" />
                    </VerticalStackLayout>

                    <!-- CEP -->
                    <VerticalStackLayout Grid.Column="1" Grid.Row="1" Spacing="5">
                        <Label Text="C.E.P:" />
                        <Entry
            Text="{Binding Usuario.CepUsuario}"
            Placeholder="CEP"
            Keyboard="Numeric"/>
                    </VerticalStackLayout>

                    <!-- Rua -->
                    <VerticalStackLayout Grid.Column="0" Grid.Row="2" Spacing="5">
                        <Label Text="Rua:" />
                        <Entry
            Text="{Binding Usuario.RuaUsuario}"
            Placeholder="Rua" />
                    </VerticalStackLayout>

                    <!-- Telefone -->
                    <VerticalStackLayout Grid.Column="1" Grid.Row="2" Spacing="5">
                        <Label Text="Telefone:" />
                        <Entry
            Text="{Binding Usuario.TelefoneUsuario}"
            Placeholder="Telefone"
            MaxLength="11"
            Keyboard="Numeric"/>
                    </VerticalStackLayout>

                    <!-- Número -->
                    <VerticalStackLayout Grid.Column="0" Grid.Row="3" Spacing="5">
                        <Label Text="Nº:" />
                        <Entry
            Text="{Binding Usuario.NumeroUsuario}"
            Placeholder="Número"
            Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <!-- Telefone de Emergência -->
                    <VerticalStackLayout Grid.Column="1" Grid.Row="3" Spacing="5">
                        <Label Text="Telefone de Emergência:" />
                        <Entry
            Text="{Binding Usuario.ContatoEmergencia}"
            Placeholder="Telefone de Emergência"
            MaxLength="11"
            Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <!-- Bairro -->
                    <VerticalStackLayout Grid.Column="0" Grid.Row="4" Spacing="5">
                        <Label Text="Bairro:" />
                        <Entry
            Text="{Binding Usuario.BairroUsuario}"
            Placeholder="Bairro" />
                    </VerticalStackLayout>

                    <!-- Peso -->
                    <VerticalStackLayout Grid.Column="1" Grid.Row="4" Spacing="5">
                        <Label Text="Peso:" />
                        <Entry
            Text="{Binding Usuario.Peso, StringFormat='Peso: {0} Kg'}"
            Placeholder="Peso"
            Keyboard="Numeric"/>
                    </VerticalStackLayout>

                    <!-- Complemento -->
                    <VerticalStackLayout Grid.Column="0" Grid.Row="5" Spacing="5">
                        <Label Text="Complemento:" />
                        <Entry
            Text="{Binding Usuario.ComplementoUsuario}"
            Placeholder="Complemento" />
                    </VerticalStackLayout>

                    <!-- Altura -->
                    <VerticalStackLayout Grid.Column="1" Grid.Row="5" Spacing="5">
                        <Label Text="Altura:" />
                        <Entry
            Text="{Binding Usuario.Altura, StringFormat='Altura: {0} cm'}"
            Placeholder="Altura"
            Keyboard="Numeric"/>
                    </VerticalStackLayout>

                    <!-- Cidade -->
                    <VerticalStackLayout Grid.Column="0" Grid.Row="6" Spacing="5">
                        <Label Text="Cidade:" />
                        <Entry
            Text="{Binding Usuario.CidadeUsuario}"
            Placeholder="Cidade" />
                    </VerticalStackLayout>

                    <!-- Tipo sanguíneo -->
                    <VerticalStackLayout Grid.Column="1" Grid.Row="6" Spacing="5">
                        <Label Text="Tipo Sanguíneo:" />
                        <Picker
            
            ItemsSource="{Binding TiposSanguineos}"
            SelectedItem="{Binding TipoSanguineoSelecionado}"/>
                    </VerticalStackLayout>

                </Grid>
                <Button Text="Salvar"
                        
                        Clicked="Button_Salvar"/>

                <Button Text="Voltar"
                        Clicked="Button_Voltar"/>

                <Label x:Name="lblMensagem" TextColor="Red" />

            </VerticalStackLayout>

        </Frame>

    </Grid>

</ContentPage>