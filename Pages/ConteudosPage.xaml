<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppAMASBE.Pages.ConteudosPage"
             Title="Conteúdos"
             BackgroundColor="#F6F7FB">

    <ScrollView>

        <VerticalStackLayout Padding="20"
                             Spacing="18">

            <Label Text="Conteúdos Educativos"
                   Style="{StaticResource TituloPagina}" />

            <Label Text="Artigos e vídeos sobre saúde preventiva e bem-estar."
                   Style="{StaticResource LabelInfoItem}"
                   HorizontalTextAlignment="Center" />

            <Frame Style="{StaticResource CardItem}">
                <VerticalStackLayout Spacing="8">

                    <Label Text="📄 Artigo | Alimentação saudável"
                           Style="{StaticResource LabelTituloItem}" />

                    <Label Text="Entenda como uma alimentação equilibrada ajuda na prevenção de doenças e melhora a qualidade de vida."
                           Style="{StaticResource LabelInfoItem}" />

                    <Button Text="Abrir artigo"
                            Clicked="OnAbrirArtigoAlimentacaoClicked"
                            Style="{StaticResource BotaoPadrao}" />

                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardItem}">
                <VerticalStackLayout Spacing="8">

                    <Label Text="🎥 Vídeo | Atividade física"
                           Style="{StaticResource LabelTituloItem}" />

                    <Label Text="Vídeo educativo sobre a importância dos exercícios físicos para a saúde do corpo e da mente."
                           Style="{StaticResource LabelInfoItem}" />

                    <Button Text="Abrir vídeo"
                            Clicked="OnAbrirVideoAtividadeClicked"
                            Style="{StaticResource BotaoPadrao}" />

                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardItem}">
                <VerticalStackLayout Spacing="8">

                    <Label Text="📄 Artigo | Hidratação"
                           Style="{StaticResource LabelTituloItem}" />

                    <Label Text="Conheça a importância da hidratação para o funcionamento do organismo e para o bem-estar diário."
                           Style="{StaticResource LabelInfoItem}" />

                    <Button Text="Abrir artigo"
                            Clicked="OnAbrirArtigoHidratacaoClicked"
                            Style="{StaticResource BotaoPadrao}" />

                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardItem}">
                <VerticalStackLayout Spacing="8">

                    <Label Text="🎥 Vídeo | Saúde mental"
                           Style="{StaticResource LabelTituloItem}" />

                    <Label Text="Conteúdo em vídeo sobre a importância de cuidar da saúde mental no dia a dia."
                           Style="{StaticResource LabelInfoItem}" />

                    <Button Text="Abrir vídeo"
                            Clicked="OnAbrirVideoSaudeMentalClicked"
                            Style="{StaticResource BotaoPadrao}" />

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>