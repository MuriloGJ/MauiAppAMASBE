<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"     
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"   
             x:Class="MauiAppAMASBE.Pages.HomePage"    
             Title=""    
             NavigationPage.HasBackButton="False"     
             Shell.BackButtonBehavior="{StaticResource NoBackButton}"     
             Shell.NavBarIsVisible="False"        
             BackgroundColor="#F6F7FB">
    <ScrollView>
        
        <VerticalStackLayout Padding="20,20,20,30"      
                             Spacing="20">
            <!-- Card topo -->
            <Frame Style="{StaticResource CardTopo}">
                <Grid ColumnDefinitions="Auto,*,Auto"        
                      VerticalOptions="Center">
                    <!-- Logo -->
                    <Image Grid.Column="0"   
                           Source="logo.png"     
                           HeightRequest="42"      
                           WidthRequest="42"      
                           Aspect="AspectFit"       
                           VerticalOptions="Center"/>
                    <!-- Textos -->
                    <VerticalStackLayout Grid.Column="1"  
                                         Margin="12,0"      
                                         VerticalOptions="Center">
                        <Label Text="Minha Saúde"  
                               FontSize="24"        
                               FontAttributes="Bold"     
                               TextColor="#1E1E1E"/>
                        <Label Text="Cuide da sua rotina"  
                               FontSize="13"     
                               TextColor="#777"/>
                    </VerticalStackLayout>
                    <!-- Botão sair -->
                    <Button Grid.Column="2"  
                            Text="Sair"   
                            Clicked="Button_Logout"   
                            BackgroundColor="#6C63FF"       
                            TextColor="White"       
                            CornerRadius="12"       
                            FontAttributes="Bold"  
                            Padding="14,6"     
                            HeightRequest="40"  
                            VerticalOptions="Center"/>
                </Grid>
            </Frame>
            <!-- Aviso -->
           <!-- <Frame BackgroundColor="#FFF3CD"    
                   CornerRadius="14"        
                   Padding="10"   
                   HasShadow="False"    
                   BorderColor="#FFE69C">
                <Label Text="⚠ Algumas funcionalidades ainda estão em desenvolvimento."  
                       TextColor="#856404"    
                       FontSize="13"       
                       HorizontalTextAlignment="Center" />
            </Frame>-->
            <!-- Grid principal -->
            <Grid ColumnDefinitions="*,*"  
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto"       
                  ColumnSpacing="14"          
                  RowSpacing="14">
                <!-- Hábitos -->
                <Frame Grid.Row="0"     
                       Grid.Column="0"      
                       Style="{StaticResource CardMenu}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHabitosTapped" />
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="8"  
                                         VerticalOptions="Center">
                        <Label Text="🏃"  
                               Style="{StaticResource IconeCardMenu}" />
                        <Label Text="Hábitos"      
                               Style="{StaticResource TextoCardMenu}" />
                    </VerticalStackLayout>
                </Frame>
                <!-- Lembretes -->
                <Frame Grid.Row="0"      
                       Grid.Column="1"       
                       Style="{StaticResource CardMenu}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLembretesTapped" />
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="8"   
                                         VerticalOptions="Center">
                        <Label Text="⏰"        
                               Style="{StaticResource IconeCardMenu}" />
                        <Label Text="Lembretes"        
                               Style="{StaticResource TextoCardMenu}" />
                    </VerticalStackLayout>
                </Frame>
                <!-- Conteúdos -->
                <Frame Grid.Row="1" 
                       Grid.Column="0"       
                       Style="{StaticResource CardMenu}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnConteudosTapped" />
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="8"    
                                         VerticalOptions="Center">
                        <Label Text="📚"       
                               Style="{StaticResource IconeCardMenu}" />
                        <Label Text="Conteúdos"     
                               Style="{StaticResource TextoCardMenu}" />
                    </VerticalStackLayout>
                </Frame>
                <!-- UBS -->
                <Frame Grid.Row="1"     
                       Grid.Column="1"   
                       Style="{StaticResource CardMenu}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnUbsTapped" />
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="8" 
                                         VerticalOptions="Center">
                        <Label Text="🏥"          
                               Style="{StaticResource IconeCardMenu}" />
                        <Label Text="Mapa UBS"   
                               Style="{StaticResource TextoCardMenu}" />
                    </VerticalStackLayout>
                </Frame>
                <!-- FAQ -->
                <Frame Grid.Row="2"       
                       Grid.Column="0"           
                       Style="{StaticResource CardMenu}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFaqTapped" />
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="8"  
                                         VerticalOptions="Center">
                        <Label Text="❓"    
                               Style="{StaticResource IconeCardMenu}" />
                        <Label Text="FAQ"    
                               Style="{StaticResource TextoCardMenu}" />
                    </VerticalStackLayout>
                </Frame>
                <!-- Bem-estar -->
                <Frame Grid.Row="2"      
                       Grid.Column="1"          
                       Style="{StaticResource CardMenu}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBemEstarTapped" />
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="8"   
                                         VerticalOptions="Center">
                        <Label Text="❤️"          
                               Style="{StaticResource IconeCardMenu}" />
                        <Label Text="Bem-estar"     
                               Style="{StaticResource TextoCardMenu}" />
                    </VerticalStackLayout>
                </Frame>
                <!-- Dados do Usuário -->
                <Frame Grid.Row="3"      
         Grid.Column="0"          
         Style="{StaticResource CardMenu}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDadosUsuarioTapped"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="8"   
                           VerticalOptions="Center">
                        <Label Text="📋"          
                 Style="{StaticResource IconeCardMenu}" />
                        <Label Text="Dados do Usuário"     
                 Style="{StaticResource TextoCardMenu}" />
                    </VerticalStackLayout>
                </Frame>
                <!-- Informaçoes -->
                <Frame Grid.Row="3"
                       Grid.Column="1"
                       Style="{StaticResource CardMenu}">
                    
                    <VerticalStackLayout Spacing="8"   
                  VerticalOptions="Center">
                        <Label Text="⚖️"          
        Style="{StaticResource IconeCardMenu}" />
                        <Label  Text="{Binding ResultadoIMCTexto}"
    
        Style="{StaticResource TextoCardMenu}" />
                    </VerticalStackLayout>
                </Frame>
                <!-- Notificação -->
                <Frame Grid.Row="4"
                       x:Name="CardNotificacao"
               Grid.Column="0"
              Style="{StaticResource CardMenu}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNotificacaoTapped"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="8"   
                  VerticalOptions="Center">
                        <Label Text="🔔"          
        Style="{StaticResource IconeCardMenu}" />
                        <Label Text="Notificações"     
        Style="{StaticResource TextoCardMenu}" />
                    </VerticalStackLayout>
                </Frame>
                <!-- Gerenciador -->
                <Frame Grid.Row="4"
               x:Name="CardGerenciador"
       Grid.Column="1"
      Style="{StaticResource CardMenu}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGerenciadorTapped"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="8"   
          VerticalOptions="Center">
                        <Label Text="🔔"          
Style="{StaticResource IconeCardMenu}" />
                        <Label Text="Gerenciador"     
Style="{StaticResource TextoCardMenu}" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>