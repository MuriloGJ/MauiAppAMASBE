<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppAMASBE.Pages.CadastroPage"
             Title="Cadastro">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15">

            <Label Text="Cadastro de Usuário"
                   FontSize="24"
                   HorizontalOptions="Center" />

            <Entry x:Name="txtNome" Placeholder="Nome" />
            <Entry x:Name="txtEmail" Placeholder="Email" />
            <Entry x:Name="txtCpf" Placeholder="CPF" />
            <Entry x:Name="txtSenha" Placeholder="Senha" IsPassword="True" />

            <Button Text="Salvar"
                    Clicked="OnSalvarClicked" />
            <Button Text="Voltar para Login"
        Clicked="OnVoltarClicked" />

            <Label x:Name="lblMensagem" TextColor="Red" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>