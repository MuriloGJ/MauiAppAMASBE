<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppAMASBE.Pages.MapsUBSPage"
             Title="Maps UBS"
             BackgroundColor="#F0EDF7">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ── CABEÇALHO ──────────────────────────────────────────── -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="24,20,24,18"
                             Spacing="16"
                             BackgroundColor="White">

            <!-- Título centralizado -->
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                <Label Text="🏥"
                       FontSize="32"
                       HorizontalOptions="Center"/>
                <Label Text="Locais Próximos"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#1A1035"
                       HorizontalOptions="Center"
                       CharacterSpacing="0.5"/>
                <Label Text="UBS e parques na sua região"
                       FontSize="13"
                       TextColor="#9B92B8"
                       HorizontalOptions="Center"
                       CharacterSpacing="0.2"/>
            </VerticalStackLayout>

            <!-- Separador sutil -->
            <BoxView Color="#EDE9F6" HeightRequest="1" Margin="0,0"/>

            <!-- Barra de busca -->
            <Frame Padding="14,10"
                   CornerRadius="28"
                   BackgroundColor="#F4F1FB"
                   BorderColor="#E4DFF5"
                   HasShadow="False">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0"
                           Text="🔍"
                           FontSize="15"
                           VerticalOptions="Center"
                           Margin="0,0,8,0"/>
                    <Entry Grid.Column="1"
                           x:Name="EntryBusca"
                           Placeholder="Buscar por nome ou bairro..."
                           PlaceholderColor="#B0A8CC"
                           TextColor="#1A1035"
                           BackgroundColor="Transparent"
                           FontSize="14"
                           TextChanged="OnBuscaTextChanged"/>
                </Grid>
            </Frame>

            <!-- Filtros e raio -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                  ColumnSpacing="10">

                <!-- Filtro UBS -->
                <Frame x:Name="FrameFiltroUbs"
                       Grid.Column="0"
                       Padding="14,8"
                       CornerRadius="22"
                       BackgroundColor="#2E86AB"
                       BorderColor="Transparent"
                       HasShadow="False">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFiltroUbsTapped"/>
                    </Frame.GestureRecognizers>
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="🏥" FontSize="13" VerticalOptions="Center"/>
                        <Label x:Name="LblFiltroUbs"
                               Text="UBS"
                               TextColor="White"
                               FontAttributes="Bold"
                               FontSize="13"
                               VerticalOptions="Center"
                               CharacterSpacing="0.3"/>
                    </HorizontalStackLayout>
                </Frame>

                <!-- Filtro Parques -->
                <Frame x:Name="FrameFiltroParques"
                       Grid.Column="1"
                       Padding="14,8"
                       CornerRadius="22"
                       BackgroundColor="#3EA55A"
                       BorderColor="Transparent"
                       HasShadow="False">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFiltroParquesTapped"/>
                    </Frame.GestureRecognizers>
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="🌳" FontSize="13" VerticalOptions="Center"/>
                        <Label x:Name="LblFiltroParques"
                               Text="Parques"
                               TextColor="White"
                               FontAttributes="Bold"
                               FontSize="13"
                               VerticalOptions="Center"
                               CharacterSpacing="0.3"/>
                    </HorizontalStackLayout>
                </Frame>

                <!-- Status centralizado -->
                <Label x:Name="LblStatus"
                       Grid.Column="2"
                       Text="Carregando..."
                       TextColor="#B0A8CC"
                       FontSize="11"
                       VerticalOptions="Center"
                       HorizontalOptions="End"/>

                <!-- Raio -->
                <Frame Grid.Column="3"
                       Padding="12,8"
                       CornerRadius="22"
                       BackgroundColor="#EDE9FF"
                       BorderColor="#D8D0F5"
                       HasShadow="False">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRaioTapped"/>
                    </Frame.GestureRecognizers>
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="📍" FontSize="11" VerticalOptions="Center"/>
                        <Label x:Name="LblRaio"
                               Text="5 km"
                               TextColor="#5A4A8A"
                               FontSize="12"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Frame>

            </Grid>
        </VerticalStackLayout>

        <!-- ── LOADING ─────────────────────────────────────────────── -->
        <ActivityIndicator x:Name="Loading"
                           Grid.Row="1"
                           Color="#6A0DAD"
                           IsRunning="False"
                           IsVisible="False"
                           HeightRequest="36"
                           Margin="0,8"/>

        <!-- ── LISTA ──────────────────────────────────────────────── -->
        <CollectionView x:Name="ListaLocais"
                        Grid.Row="2"
                        Margin="20,10"
                        SelectionMode="None">

            <!-- Estado vazio -->
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="14"
                                     Padding="40">
                    <Label Text="🗺️"
                           FontSize="56"
                           HorizontalOptions="Center"/>
                    <Label Text="Nenhum local encontrado"
                           TextColor="#5A4A8A"
                           FontSize="17"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Tente aumentar o raio de busca ou ajuste os filtros."
                           TextColor="#B0A8CC"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           LineHeight="1.4"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <!-- Card de cada local -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5"
                           Padding="16,14"
                           CornerRadius="20"
                           BackgroundColor="White"
                           BorderColor="#EDE9FF"
                           HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnLocalTapped"
                                CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="54,*,Auto"
                              ColumnSpacing="12">

                            <!-- Ícone com fundo suave -->
                            <Frame Grid.Column="0"
                                   Padding="0"
                                   CornerRadius="16"
                                   BackgroundColor="#F0EDF7"
                                   BorderColor="Transparent"
                                   HasShadow="False"
                                   HeightRequest="50"
                                   WidthRequest="50"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <Label Text="{Binding Icone}"
                                       FontSize="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>

                            <!-- Informações -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Nome}"
                                       TextColor="#1A1035"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding Tipo}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#6A0DAD"
                                       CharacterSpacing="0.3"/>
                                <Label Text="{Binding Endereco}"
                                       TextColor="#9B92B8"
                                       FontSize="12"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>

                            <!-- Seta -->
                            <Frame Grid.Column="2"
                                   Padding="8,6"
                                   CornerRadius="12"
                                   BackgroundColor="#F0EDF7"
                                   BorderColor="Transparent"
                                   HasShadow="False"
                                   VerticalOptions="Center">
                                <Label Text="›"
                                       TextColor="#6A0DAD"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center"/>
                            </Frame>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ── PAINEL DE DETALHE ──────────────────────────────────── -->
        <Frame x:Name="PainelDetalhe"
               Grid.Row="3"
               IsVisible="False"
               Padding="22,20"
               CornerRadius="24"
               BackgroundColor="White"
               BorderColor="#EDE9FF"
               Margin="20,0,20,20"
               HasShadow="True">

            <VerticalStackLayout Spacing="14">

                <!-- Cabeçalho do detalhe -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                        <Label x:Name="LblDetalheNome"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#1A1035"
                               LineBreakMode="WordWrap"/>
                        <Label x:Name="LblDetalheTipo"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#6A0DAD"
                               CharacterSpacing="0.4"/>
                    </VerticalStackLayout>

                    <!-- Botão fechar -->
                    <Frame Grid.Column="1"
                           Padding="0"
                           CornerRadius="18"
                           BackgroundColor="#F4F1FB"
                           BorderColor="Transparent"
                           HasShadow="False"
                           HeightRequest="36"
                           WidthRequest="36"
                           VerticalOptions="Start">
                        <Button Text="✕"
                                Clicked="OnFecharDetalheTapped"
                                BackgroundColor="Transparent"
                                TextColor="#9B92B8"
                                FontSize="14"
                                Padding="0"
                                HeightRequest="36"
                                WidthRequest="36"/>
                    </Frame>
                </Grid>

                <!-- Divisor -->
                <BoxView Color="#F0EDF7" HeightRequest="1.5" Margin="0,0"/>

                <!-- Endereço -->
                <Frame Padding="12,10"
                       CornerRadius="14"
                       BackgroundColor="#F8F6FF"
                       BorderColor="Transparent"
                       HasShadow="False">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="📍" FontSize="15" VerticalOptions="Center"/>
                        <Label x:Name="LblDetalheEndereco"
                               TextColor="#3D3060"
                               FontSize="13"
                               VerticalOptions="Center"
                               LineBreakMode="WordWrap"/>
                    </HorizontalStackLayout>
                </Frame>

                <!-- Telefone -->
                <Frame x:Name="RowTelefone"
                       Padding="12,10"
                       CornerRadius="14"
                       BackgroundColor="#F0F9F3"
                       BorderColor="Transparent"
                       HasShadow="False"
                       IsVisible="False">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="📞" FontSize="15" VerticalOptions="Center"/>
                        <Label x:Name="LblDetalheTelefone"
                               TextColor="#2A6040"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Frame>

                <!-- Horário -->
                <Frame x:Name="RowHorario"
                       Padding="12,10"
                       CornerRadius="14"
                       BackgroundColor="#FFF8F0"
                       BorderColor="Transparent"
                       HasShadow="False"
                       IsVisible="False">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="🕐" FontSize="15" VerticalOptions="Center"/>
                        <Label x:Name="LblDetalheHorario"
                               TextColor="#7A4A10"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Frame>

                <!-- Botão navegar -->
                <Button Text="🗺️   Como chegar"
                        Clicked="OnNavegacaoTapped"
                        BackgroundColor="#6A0DAD"
                        TextColor="White"
                        CornerRadius="14"
                        FontAttributes="Bold"
                        FontSize="15"
                        CharacterSpacing="0.3"
                        HeightRequest="50"
                        Margin="0,4,0,0"/>

            </VerticalStackLayout>
        </Frame>

    </Grid>
</ContentPage>
