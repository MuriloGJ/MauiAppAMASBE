<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppAMASBE.Pages.MapsUBSPage"
             Title=""
             BackgroundColor="#87CEEB"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ══ CABEÇALHO FUTURISTA ══════════════════════════════════════ -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="{OnPlatform Android='20,28,20,16'}"
                             Spacing="14"
                             BackgroundColor="#87CEEB">

            <!-- Linha decorativa topo -->
            <BoxView HeightRequest="1"
                     BackgroundColor="#00E5FF"
                     Opacity="0.25"
                     Margin="-20,0"/>

            <!-- Título + Botão Raio -->
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="RADAR URBANO"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#0A0E1A"
                           CharacterSpacing="4"/>
                    <Label Text="UBS · Hospitais · Parques"
                           FontSize="11"
                           TextColor="#2E6090"
                           CharacterSpacing="2"/>
                </VerticalStackLayout>

                <Frame Grid.Column="1"
                       Padding="14,8"
                       CornerRadius="20"
                       BackgroundColor="#141C30"
                       BorderColor="#1A3A5F"
                       HasShadow="False">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRaioTapped"/>
                    </Frame.GestureRecognizers>
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="◎" FontSize="11" TextColor="#00E5FF" VerticalOptions="Center"/>
                        <Label x:Name="LblRaio"
                               Text="5 km"
                               TextColor="#00E5FF"
                               FontAttributes="Bold"
                               FontSize="12"
                               CharacterSpacing="1"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Frame>
            </Grid>

            <!-- Barra de busca -->
            <Frame Padding="14,0"
                   CornerRadius="14"
                   BackgroundColor="#111827"
                   BorderColor="#1A2E4A"
                   HasShadow="False"
                   HeightRequest="48">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0"
                           Text="🔍"
                           FontSize="15"
                           TextColor="#00E5FF"
                           VerticalOptions="Center"
                           Margin="0,0,10,0"/>
                    <Entry Grid.Column="1"
                           x:Name="EntryBusca"
                           Placeholder="Buscar hospital, UBS, parque..."
                           PlaceholderColor="#1E3A5A"
                           TextColor="#C8E0FF"
                           BackgroundColor="Transparent"
                           FontSize="14"
                           VerticalOptions="Center"
                           TextChanged="OnBuscaTextChanged"/>
                </Grid>
            </Frame>

            <!-- Filtros -->
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">

                <Frame x:Name="FrameFiltroUbs"
                       Grid.Column="0"
                       Padding="14,8"
                       CornerRadius="22"
                       BackgroundColor="#00C2E0"
                       BorderColor="Transparent"
                       HasShadow="False">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFiltroUbsTapped"/>
                    </Frame.GestureRecognizers>
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="🏥" FontSize="12" VerticalOptions="Center"/>
                        <Label x:Name="LblFiltroUbs"
                               Text="UBS"
                               TextColor="#0A0E1A"
                               FontAttributes="Bold"
                               FontSize="12"
                               CharacterSpacing="0.5"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Frame>

                <Frame x:Name="FrameFiltroParques"
                       Grid.Column="1"
                       Padding="14,8"
                       CornerRadius="22"
                       BackgroundColor="#00E5A0"
                       BorderColor="Transparent"
                       HasShadow="False">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFiltroParquesTapped"/>
                    </Frame.GestureRecognizers>
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="🌳" FontSize="12" VerticalOptions="Center"/>
                        <Label x:Name="LblFiltroParques"
                               Text="Parques"
                               TextColor="#0A0E1A"
                               FontAttributes="Bold"
                               FontSize="12"
                               CharacterSpacing="0.5"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Frame>

                <Label x:Name="LblStatus"
                       Grid.Column="2"
                       Text="Escaneando..."
                       TextColor="#1E4060"
                       FontSize="11"
                       CharacterSpacing="1"
                       VerticalOptions="Center"
                       HorizontalOptions="End"/>
            </Grid>
        </VerticalStackLayout>

        <!-- ══ LOADING ════════════════════════════════════════════════ -->
        <ActivityIndicator x:Name="Loading"
                           Grid.Row="1"
                           Color="#00E5FF"
                           IsRunning="False"
                           IsVisible="False"
                           HeightRequest="32"
                           Margin="0,6"/>

        <!-- ══ LISTA ══════════════════════════════════════════════════ -->
        <CollectionView x:Name="ListaLocais"
                        Grid.Row="2"
                        Margin="16,8"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="14"
                                     Padding="40">
                    <Label Text="◌"
                           FontSize="56"
                           TextColor="#0E2040"
                           HorizontalOptions="Center"/>
                    <Label Text="NENHUM SINAL DETECTADO"
                           TextColor="#0E2A48"
                           FontSize="13"
                           FontAttributes="Bold"
                           CharacterSpacing="3"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Aumente o raio ou ajuste os filtros."
                           TextColor="#0A1E30"
                           FontSize="12"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5"
                           Padding="0"
                           CornerRadius="18"
                           BackgroundColor="#0F1628"
                           BorderColor="#142040"
                           HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnLocalTapped"
                                CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>

                        <Grid ColumnDefinitions="5,56,*,Auto" ColumnSpacing="0">

                            <!-- Barra lateral fixa cyan (UBS) — parques terão verde via code-behind se quiser -->
                            <BoxView Grid.Column="0"
                                     CornerRadius="18,0,0,18"
                                     WidthRequest="5"
                                     BackgroundColor="#00C2E0"/>

                            <!-- Ícone -->
                            <Frame Grid.Column="1"
                                   Padding="0"
                                   CornerRadius="14"
                                   BackgroundColor="#111827"
                                   BorderColor="Transparent"
                                   HasShadow="False"
                                   HeightRequest="44"
                                   WidthRequest="44"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <Label Text="{Binding Icone}"
                                       FontSize="21"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>

                            <!-- Dados -->
                            <VerticalStackLayout Grid.Column="2"
                                                 Spacing="3"
                                                 VerticalOptions="Center"
                                                 Padding="6,12">
                                <Label Text="{Binding Nome}"
                                       TextColor="#B8D8FF"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding Tipo}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="#00E5FF"
                                       CharacterSpacing="2"/>
                                <Label Text="{Binding Endereco}"
                                       TextColor="#1E4060"
                                       FontSize="11"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>

                            <!-- Seta -->
                            <Frame Grid.Column="3"
                                   Padding="8,6"
                                   CornerRadius="10"
                                   BackgroundColor="#111827"
                                   BorderColor="Transparent"
                                   HasShadow="False"
                                   VerticalOptions="Center"
                                   Margin="0,0,12,0">
                                <Label Text="›"
                                       TextColor="#1A4070"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center"/>
                            </Frame>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ══ PAINEL DE DETALHE ══════════════════════════════════════ -->
        <Frame x:Name="PainelDetalhe"
               Grid.Row="3"
               IsVisible="False"
               Padding="20,18"
               CornerRadius="22"
               BackgroundColor="#0D1628"
               BorderColor="#0E2848"
               Margin="16,0,16,16"
               HasShadow="True">

            <VerticalStackLayout Spacing="12">

                <!-- Cabeçalho -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                        <Label x:Name="LblDetalheNome"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#B8D8FF"
                               LineBreakMode="WordWrap"/>
                        <Label x:Name="LblDetalheTipo"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#00E5FF"
                               CharacterSpacing="2"/>
                    </VerticalStackLayout>

                    <Frame Grid.Column="1"
                           Padding="0"
                           CornerRadius="18"
                           BackgroundColor="#111827"
                           BorderColor="Transparent"
                           HasShadow="False"
                           HeightRequest="36"
                           WidthRequest="36"
                           VerticalOptions="Start">
                        <Button Text="✕"
                                Clicked="OnFecharDetalheTapped"
                                BackgroundColor="Transparent"
                                TextColor="#2A5070"
                                FontSize="14"
                                Padding="0"
                                HeightRequest="36"
                                WidthRequest="36"/>
                    </Frame>
                </Grid>

                <!-- Divisória -->
                <BoxView Color="#0C1E38" HeightRequest="1"/>

                <!-- Endereço -->
                <Frame Padding="12,10"
                       CornerRadius="12"
                       BackgroundColor="#0C1A2E"
                       BorderColor="Transparent"
                       HasShadow="False">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="📍" FontSize="14" VerticalOptions="Center"/>
                        <Label x:Name="LblDetalheEndereco"
                               TextColor="#4A80A8"
                               FontSize="13"
                               VerticalOptions="Center"
                               LineBreakMode="WordWrap"/>
                    </HorizontalStackLayout>
                </Frame>

                <!-- Telefone — Frame como no projeto original -->
                <Frame x:Name="RowTelefone"
                       Padding="12,10"
                       CornerRadius="12"
                       BackgroundColor="#0A1E18"
                       BorderColor="Transparent"
                       HasShadow="False"
                       IsVisible="False">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="📞" FontSize="14" VerticalOptions="Center"/>
                        <Label x:Name="LblDetalheTelefone"
                               TextColor="#00C8A0"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Frame>

                <!-- Horário — Frame como no projeto original -->
                <Frame x:Name="RowHorario"
                       Padding="12,10"
                       CornerRadius="12"
                       BackgroundColor="#1A1408"
                       BorderColor="Transparent"
                       HasShadow="False"
                       IsVisible="False">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="🕐" FontSize="14" VerticalOptions="Center"/>
                        <Label x:Name="LblDetalheHorario"
                               TextColor="#C8A020"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Frame>

                <!-- Botão navegar -->
                <Button Text="🗺️   Como chegar"
                        Clicked="OnNavegacaoTapped"
                        BackgroundColor="#00C2E0"
                        TextColor="#0A0E1A"
                        CornerRadius="14"
                        FontAttributes="Bold"
                        FontSize="15"
                        CharacterSpacing="0.5"
                        HeightRequest="50"
                        Margin="0,4,0,0"/>

            </VerticalStackLayout>
        </Frame>

    </Grid>
</ContentPage>
