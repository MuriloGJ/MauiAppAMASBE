<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppAMASBE.Pages.HabitosPage"
    Title="Hábitos"
    BackgroundColor="#F6F7FB">

    <Grid Padding="10">

        <ScrollView>
            <VerticalStackLayout Spacing="15">

                <Label Text="Meus Hábitos"
                       Style="{StaticResource TituloPagina}" />

                <VerticalStackLayout x:Name="EmptyState"
                                     Spacing="10"
                                     HorizontalOptions="Center">

                    <Label Text="📋"
                           FontSize="50"
                           HorizontalOptions="Center" />

                    <Label Text="Crie novos hábitos!"
                           FontSize="16"
                           TextColor="#666"
                           HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

                <Button Text="+ Novo Hábito"
                        Clicked="OnNovoHabitoClicked"
                        Style="{StaticResource BotaoPadrao}" />

                <Frame x:Name="ListaCard"
                       Style="{StaticResource CardLista}"
                       Margin="0,10">

                    <ListView x:Name="lst_habito"
                              IsPullToRefreshEnabled="True"
                              Refreshing="lst_habito_Refreshing"
                              ItemSelected="lst_habito_ItemSelected"
                              HasUnevenRows="True"
                              SeparatorVisibility="None"
                              BackgroundColor="Transparent">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>

                                    <ViewCell.ContextActions>
                                        <MenuItem Text="Remover"
                                                  Clicked="MenuItem_Remover_Habito"/>
                                        <MenuItem Text="Editar"
                                                  Clicked="MenuItem_Editar_Habito"/>
                                    </ViewCell.ContextActions>

                                    <Frame Style="{StaticResource CardItem}"
                                           Margin="10,8">

                                        <VerticalStackLayout Spacing="6">

                                            <Label Text="{Binding NomeHabito}"
                                                   Style="{StaticResource LabelTituloItem}" />

                                            <Label Text="{Binding DescricaoHabito}"
                                                   Style="{StaticResource LabelInfoItem}" />

                                            <Label Text="{Binding FrequenciaHabito, StringFormat='Frequência: {0}'}"
                                                   Style="{StaticResource LabelInfoItem}" />

                                            <Label Text="{Binding HorarioHabito, StringFormat='Horário: {0}'}"
                                                   Style="{StaticResource LabelInfoItem}" />

                                            <HorizontalStackLayout Spacing="5">
                                                <Label Text="Meta:"
                                                       FontAttributes="Bold"
                                                       TextColor="#333"/>
                                                <Label Text="{Binding MetaValor}"
                                                       TextColor="#333"/>
                                                <Label Text="{Binding MetaUnidade}"
                                                       TextColor="#333"/>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Spacing="10">
                                                <Label Text="{Binding Progresso, StringFormat='Progresso: {0:F0}%'}"
                                                       TextColor="#333"
                                                       VerticalOptions="Center"/>

                                                <Stepper Minimum="0"
                                                         Maximum="{Binding MetaValor}"
                                                         Increment="1"
                                                         Value="{Binding ValorAtual}"
                                                         ValueChanged="Stepper_ValueChanged"/>
                                            </HorizontalStackLayout>

                                        </VerticalStackLayout>

                                    </Frame>

                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                    </ListView>

                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Card cadastro -->
        <Frame x:Name="CadastroCard"
               IsVisible="False"
               BackgroundColor="#F4F1FF"
               CornerRadius="20"
               Padding="20"
               Margin="20"
               HasShadow="True"
               VerticalOptions="Center">

            <VerticalStackLayout Spacing="15">

                <Label Text="Novo Hábito"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#1E1E1E"/>

                <Entry x:Name="NomeEntry"
                       Placeholder="Nome do hábito"
                       Style="{StaticResource EntryPadrao}" />

                <Entry x:Name="TipoEntry"
                       Placeholder="Tipo (Ex: Exercício)"
                       Style="{StaticResource EntryPadrao}" />

                <Entry x:Name="DescricaoEntry"
                       Placeholder="Descrição (Ex: Caminhar por 1 hora)"
                       Style="{StaticResource EntryPadrao}" />

                <Label Text="Hora do Hábito"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#1E1E1E"/>

                <TimePicker x:Name="timeHorario"
                            Format="HH:mm"
                            TextColor="#333"/>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="10">

                    <Entry Grid.Column="0"
                           x:Name="MetaEntry"
                           Placeholder="Meta Nº (Ex: 5)"
                           Keyboard="Numeric"
                           Style="{StaticResource EntryPadrao}" />

                    <Picker Grid.Column="1"
                            Title="Unidade"
                            Style="{StaticResource PickerPadrao}"
                            ItemsSource="{Binding Unidades}"
                            SelectedItem="{Binding UnidadeSelecionada}" />

                </Grid>

                <Picker x:Name="pck_frequencia"
                        Title="Selecione a frequência"
                        Style="{StaticResource PickerPadrao}"
                        ItemsSource="{Binding Frequencias}"
                        SelectedItem="{Binding FrequenciaSelecionada}" />

                <Button Text="Salvar"
                        Clicked="OnSalvarHabitoClicked"
                        Style="{StaticResource BotaoPadrao}" />

                <Button Text="Cancelar"
                        Clicked="OnCancelarClicked"
                        Style="{StaticResource BotaoSecundario}" />

            </VerticalStackLayout>

        </Frame>

        <!-- Card edição -->
        <Frame x:Name="EditCard"
               IsVisible="False"
               BackgroundColor="#F4F1FF"
               CornerRadius="20"
               Padding="20"
               Margin="20"
               HasShadow="True"
               VerticalOptions="Center">

            <VerticalStackLayout Spacing="15">

                <Label Text="Editar Hábito"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#1E1E1E"/>

                <Entry x:Name="Edit_NomeEntry"
                       Text="{Binding NomeHabito}"
                       Placeholder="Nome do hábito"
                       Style="{StaticResource EntryPadrao}" />

                <Entry x:Name="Edit_DescricaoEntry"
                       Text="{Binding DescricaoHabito}"
                       Placeholder="Descrição do hábito"
                       Style="{StaticResource EntryPadrao}" />

                <Label Text="Hora do Hábito"
                       TextColor="#333"
                       FontAttributes="Bold"/>

                <TimePicker x:Name="Edit_timeHorario"
                            Format="HH:mm"
                            TextColor="#333"/>

                <Entry x:Name="Edit_MetaEntry"
                       Placeholder="Meta (Ex: 5)"
                       Keyboard="Numeric"
                       Style="{StaticResource EntryPadrao}" />

                <Picker x:Name="Edit_pck_frequencia"
                        Title="Selecione a frequência"
                        Style="{StaticResource PickerPadrao}"
                        ItemsSource="{Binding Frequencias}"
                        SelectedItem="{Binding FrequenciaSelecionada}" />

                <Button Text="Salvar"
                        Clicked="Button_Editar_Habito"
                        Style="{StaticResource BotaoPadrao}" />

                <Button Text="Cancelar Edição"
                        Clicked="Button_Cancelar_edicao"
                        Style="{StaticResource BotaoSecundario}" />

            </VerticalStackLayout>

        </Frame>

    </Grid>

</ContentPage>