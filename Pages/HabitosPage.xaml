<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppAMASBE.Pages.HabitosPage"
    Title="Hábitos"
 BackgroundColor="#F6F7FB">
    <ScrollView>
        
    <Grid Padding="10">
        

        <VerticalStackLayout Spacing="15">
                <Label Text="Meus Hábitos"
         Style="{StaticResource TituloPagina}" />


                <!-- Estado vazio -->
            <VerticalStackLayout 
                x:Name="EmptyState"
                Spacing="10"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                    
                
                <Label Text="📋"
                       FontSize="50"
                       HorizontalOptions="Center" />

                <Label Text="Crie novos hábitos!"
                       FontSize="16"
                       TextColor="#666"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <!-- Botão -->
            <Button Text="+ Novo Hábito"
                    Clicked="OnNovoHabitoClicked"
                    Style="{StaticResource BotaoPadrao}" />
                

                <!-- Lista -->
                <Frame Padding="0"
       Margin="0,10"
       CornerRadius="15"
       HasShadow="True"
       BackgroundColor="White">

                <ListView x:Name="lst_habito"
                          IsPullToRefreshEnabled="True"
                          Refreshing="lst_habito_Refreshing"
                          ItemSelected="lst_habito_ItemSelected"
                          HasUnevenRows="True"
                          SeparatorVisibility="None"
                    BackgroundColor="Transparent">

                    <ListView.ItemTemplate>
                            <DataTemplate>
                            <ViewCell>

                                <ViewCell.ContextActions>
                                    <MenuItem Text="Remover"
                                              Clicked="MenuItem_Remover_Habito"/>

                                    <MenuItem Text="Editar"
                                              Clicked="MenuItem_Editar_Habito"/>
                                </ViewCell.ContextActions>

                                    <Frame Margin="10,8"
                           Padding="15"
                           CornerRadius="15"
                           BackgroundColor="White"
                                           
                           HasShadow="True">

                                        <VerticalStackLayout Spacing="6">

                                            <Label Text="{Binding NomeHabito}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#1E1E1E"/>

                                            <Label Text="{Binding DescricaoHabito}"
                                   FontSize="14"
                                   TextColor="#666"/>

                                            <Label Text="{Binding FrequenciaHabito, StringFormat='Frequência: {0}'}"
                                   FontSize="14"
                                   TextColor="#666"/>

                                            <Label Text="{Binding HorarioHabito, StringFormat='Horário: {0}'}"
                                   FontSize="14"
                                   TextColor="#666"/>

                                            <HorizontalStackLayout Spacing="5">

                                                <Label Text="Meta:"
                                       FontAttributes="Bold"
                                       TextColor="#333"/>

                                                <Label Text="{Binding MetaValor}"
                                       TextColor="#333"/>

                                                <Label Text="{Binding MetaUnidade}"
                                       TextColor="#333"/>

                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Spacing="10"
                                                                   >

                                                <Label Text="{Binding Progresso, StringFormat='Progresso: {0:F0}%'}"
                                       TextColor="#333"
                                       VerticalOptions="Center"/>

                                                <Stepper Minimum="0"
                                                         BackgroundColor="#333"
                                                     Maximum="{Binding MetaValor}"
                                                     Increment="1"
                                                     Value="{Binding ValorAtual}"
                                                     ValueChanged="Stepper_ValueChanged"/>

                                            </HorizontalStackLayout>

                                        </VerticalStackLayout>

                                    </Frame>

                            </ViewCell>
                            </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

                </Frame>
                <Button Text="Voltar"
                Clicked="ButtonVoltar"
                 Style="{StaticResource BotaoSecundario}" />

            </VerticalStackLayout>

        <!-- Card cadastro -->
        <Frame x:Name="CadastroCard"
               IsVisible="False"
               Style="{StaticResource CardFormulario}"
               Margin="20"
               BackgroundColor="#777"
               VerticalOptions="Center">

            <VerticalStackLayout Spacing="12"
                                 BackgroundColor="#777"
                                 Padding="15"
                                 Margin="5">

                <Label Text="Novo Hábito"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#1E1E1E"/>

                <Entry x:Name="NomeEntry"
                       Placeholder="Nome do hábito"
                       TextColor="#333"
                       PlaceholderColor="#777"/>

                <Entry x:Name="TipoEntry"
                       Placeholder="Tipo (Ex: Exercício)"
                       TextColor="#333"
                       PlaceholderColor="#777"/>

                <Entry x:Name="DescricaoEntry"
                       Placeholder="Descrição (Ex: Caminhar por 1 hora)"
                       TextColor="#333"
                       PlaceholderColor="#777"/>

                <Label Text="Hora do Hábito"
                       TextColor="#1E1E1E"
                       FontSize="18"
                       FontAttributes="Bold"/>

                <TimePicker x:Name="timeHorario"
                            Format="HH:mm"
                            TextColor="#333"/>

                <Entry x:Name="MetaEntry"
                       Placeholder="Meta Nº (Ex: 5.5)"
                       Keyboard="Numeric"
                       TextColor="#333"
                       PlaceholderColor="#777"/>

                <Picker Title="Unidade"
                        TextColor="#333"
                        TitleColor="#777"
                        ItemsSource="{Binding Unidades}"
                        SelectedItem="{Binding UnidadeSelecionada}" />

                <Picker x:Name="pck_frequencia"
                        Title="Selecione a frequência"
                        TextColor="#333"
                        TitleColor="#777"
                        ItemsSource="{Binding Frequencias}"
                        SelectedItem="{Binding FrequenciaSelecionada}" />

                <Button Text="Salvar"
                        Clicked="OnSalvarHabitoClicked"
                        BackgroundColor="#6A0DAD"
                        TextColor="White"
                        CornerRadius="10"/>

                <Button Text="Cancelar"
                        Clicked="OnCancelarClicked"
                        Style="{StaticResource BotaoSecundario}" />

            </VerticalStackLayout>

        </Frame>

        <!-- Card edição -->
        <Frame x:Name="EditCard"
               IsVisible="False"
               Style="{StaticResource CardFormulario}"
               Margin="5"
               BackgroundColor="#6A0DAD"
               VerticalOptions="Center">

            <VerticalStackLayout Spacing="12"
                                 BackgroundColor="#F4F1FF"
                                 Padding="15"
                                 Margin="5">

                <Label Text="Editar Hábito"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#1E1E1E"/>

                <Label Text="Nome do Hábito"
                       TextColor="#333"/>

                <Entry x:Name="Edit_NomeEntry"
                       Text="{Binding NomeHabito}"
                       TextColor="#333"
                       PlaceholderColor="#777"/>

                <Label Text="Descrição do Hábito"
                       TextColor="#333"/>

                <Entry x:Name="Edit_DescricaoEntry"
                       Text="{Binding DescricaoHabito}"
                       TextColor="#333"
                       PlaceholderColor="#777"/>

                <Label Text="Hora do Hábito"
                       TextColor="#333"/>

                <TimePicker x:Name="Edit_timeHorario"
                            Format="HH:mm"
                            TextColor="#333"/>

                <Label Text="Nº de vezes"
                       TextColor="#333"/>

                <Entry x:Name="Edit_MetaEntry"
                       Placeholder="Meta (Ex: 5.5)"
                       Keyboard="Numeric"
                       TextColor="#333"
                       PlaceholderColor="#777"/>

                <Picker x:Name="Edit_pck_frequencia"
                        Title="Selecione a frequência"
                        TextColor="#333"
                        TitleColor="#777"
                        ItemsSource="{Binding Frequencias}"
                        SelectedItem="{Binding FrequenciaSelecionada}" />

                <Button Text="Salvar"
                        Clicked="Button_Editar_Habito"
                        BackgroundColor="#6A0DAD"
                        TextColor="White"
                        CornerRadius="10"/>

                <Button Text="Cancelar Edição"
                        Clicked="Button_Cancelar_edicao"
                        BackgroundColor="Gray"
                        TextColor="White"
                        CornerRadius="10"/>

            </VerticalStackLayout>

        </Frame>

    </Grid>
    </ScrollView>
</ContentPage>