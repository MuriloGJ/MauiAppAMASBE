<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppAMASBE.Pages.LembretesPage"
             Title="Lembretes"
             BackgroundColor="#F6F7FB">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ Novo"
                     Clicked="OnNovoLembreteClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Meus Lembretes"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#1E1E1E"
                   HorizontalOptions="Center" />

            <Frame x:Name="EmptyState"
                   BackgroundColor="#EDE9FF"
                   CornerRadius="18"
                   Padding="20"
                   HasShadow="False">

                <VerticalStackLayout Spacing="12"
                                     HorizontalOptions="Center">

                    <Label Text="⏰"
                           FontSize="50"
                           HorizontalOptions="Center" />

                    <Label Text="Adicionar novos lembretes!"
                           FontSize="16"
                           TextColor="#403A5F"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Clique em + Novo para criar lembretes de vacina, medicamento, exame ou consulta."
                           FontSize="13"
                           TextColor="#666"
                           HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Frame>

            <Frame x:Name="CadastroCard"
                   IsVisible="False"
                   BackgroundColor="White"
                   CornerRadius="18"
                   Padding="18"
                   HasShadow="True">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Novo Lembrete"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#403A5F"
                           HorizontalOptions="Center" />

                    <Picker x:Name="TipoPicker"
                            Title="Tipo de lembrete">
                        <Picker.Items>
                            <x:String>Consulta</x:String>
                            <x:String>Vacina</x:String>
                            <x:String>Medicamento</x:String>
                            <x:String>Exame</x:String>
                        </Picker.Items>
                    </Picker>

                    <Entry x:Name="DescricaoEntry"
                           Placeholder="Descrição do lembrete" />

                    <Entry x:Name="DataEntry"
                           Placeholder="Data (ex: 10/05/2026)" />

                    <Entry x:Name="HoraEntry"
                           Placeholder="Hora (ex: 14:00)" />

                    <Entry x:Name="FrequenciaEntry"
                           Placeholder="Frequência (ex: único, diário, mensal)" />

                    <Button Text="Salvar lembrete"
                            BackgroundColor="#6C63FF"
                            TextColor="White"
                            CornerRadius="12"
                            Clicked="OnSalvarLembreteClicked" />

                    <Button Text="Cancelar"
                            BackgroundColor="Transparent"
                            TextColor="#6C63FF"
                            Clicked="OnCancelarClicked" />

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>